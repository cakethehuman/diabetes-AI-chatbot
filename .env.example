# Salin jadi .env lalu isi: cp .env.example .env
# Jangan commit .env — isinya API key.

# --- Image (dipakai docker-compose) --------------------------------------
IMAGE_NAME=USERNAME/chat-dokumen
IMAGE_TAG=latest

# --- Port di host --------------------------------------------------------
APP_PORT=8501
# 0.0.0.0 = bisa diakses dari luar. Pakai 127.0.0.1 kalau di belakang nginx.
APP_HOST=0.0.0.0

# --- LLM (OpenAI atau gateway OpenAI-compatible) -------------------------
LLM_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
LLM_MODEL=gpt-4o-mini
# Kosongkan kalau pakai api.openai.com. Isi kalau lewat gateway
# (vLLM, LiteLLM, OpenRouter, dll) — biasanya berakhiran /v1
LLM_BASE_URL=
# Dipakai hanya kalau LLM_MODEL tanpa prefix provider
LLM_PROVIDER=openai

# --- Embedding Jina AI ---------------------------------------------------
# Ambil gratis di https://jina.ai/embeddings/
JINA_API_KEY=jina_xxxxxxxxxxxxxxxxxxxxxxxx
JINA_MODEL=jina-embeddings-v3
# v3 = 1024, v4 = 2048. Ganti nilai ini = index lama harus dihapus.
JINA_DIMENSIONS=1024

# --- Retrieval -----------------------------------------------------------
AGENT_TOP_K=5

# --- Penyimpanan (hanya untuk jalan tanpa Docker) ------------------------
SEMSEARCH_DB=.chroma_db
SEMSEARCH_COLLECTION=docs
SEMSEARCH_UPLOADS=data